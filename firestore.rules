rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'calskanatakan55@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public site content: anyone can read, only admin can write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experiences/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /techStack/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /socials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form: visitors may only create a well-formed, unread message
    match /messages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'email', 'message', 'createdAt', 'isRead', 'isStarred', 'isArchived'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt is string
        && request.resource.data.isRead == false
        && request.resource.data.isStarred == false
        && request.resource.data.isArchived == false;
    }

    // Page view counters: visitors may only bump counters by one
    match /analytics/{docId} {
      allow read, delete: if isAdmin();

      allow create, update: if docId == '_totals'
        && request.resource.data.keys().hasOnly(['totalPageViews'])
        && request.resource.data.totalPageViews
             == (resource == null ? 0 : resource.data.totalPageViews) + 1;

      allow create, update: if docId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(
             ['date', 'pageViews', 'uniqueVisitors', 'visitors', 'pages',
              'referrers', 'devices', 'browsers', 'countries'])
        && request.resource.data.date == docId
        && request.resource.data.pageViews
             == (resource == null ? 0 : resource.data.pageViews) + 1;
    }
  }
}
